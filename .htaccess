# ============================================================
# U.P. System Cash Office Integrated Web System
# Apache configuration — cPanel, shared hosting, most VPS setups.
#
# Optional. The portal works without this file: every page already
# carries the same Content-Security-Policy in a <meta> tag. What a
# real response header adds is frame-ancestors, which <meta> ignores
# entirely, so this is the only place clickjacking can be refused.
#
# On Netlify or Cloudflare Pages this file does nothing — use
# _headers there instead. Apache blocks .ht* files from being served
# by default, so leaving it in place on any host is harmless.
# ============================================================

# ---- security headers ----
<IfModule mod_headers.c>
  # The connect-src AND img-src directives below are GENERATED.
  # `node sync-csp.js` reads SUPABASE_URL out of config.js and rewrites
  # both here as well as in the nine pages — do not edit them by hand.
  #
  # img-src names the project because the news-images Storage bucket is
  # private: its images arrive as signed URLs from the project host, not
  # as public asset URLs, so 'self' does not cover them. `data:` stays
  # for inline thumbnails and the UP seal.
  #
  # It did not always cover this file, and the omission was worse than
  # it looks. When a response header and a <meta> tag both carry a CSP,
  # the browser enforces BOTH policies independently: a request has to
  # satisfy every one of them, so the effective policy is the
  # intersection. A stale connect-src here therefore does not lose to
  # the fresh one in the pages — it blocks every Supabase request the
  # pages are allowing, and the symptom is a portal that looks like a
  # backend outage with nothing in the network tab pointing at the CSP.
  # That is exactly the failure sync-csp.js was written to prevent, in
  # the one file it used to skip.
  #
  # script-src has no 'unsafe-inline'. That is deliberate and it is
  # why the page-*.js files exist. Do not add it back to make an
  # inline script work; move the script into the page's .js file.
  #
  # THIS IS THE CDN BUILD. script-src names cdn.jsdelivr.net and
  # cdn.sheetjs.com because the pages load supabase-js and xlsx from
  # them directly, at pinned versions, with an integrity= hash on each
  # tag (run `node sync-sri.js` to generate or re-check those hashes).
  # vendor/ does not exist in this snapshot and sync-vendor.js is not
  # wired to anything — see the build note in .gitignore, which is the
  # file that says which of the two builds you are looking at.
  #
  # This comment used to claim the opposite: that the CDN origins were
  # gone and both libraries came from vendor/. They never did in this
  # snapshot, and the line directly below said so the whole time. A
  # comment that contradicts the config six lines under it is worse
  # than no comment, because the next person reasons from it — reads
  # "script-src is 'self' alone", concludes a CDN tag cannot possibly
  # execute, and stops looking.
  #
  # If you finish the move to vendor/: drop both origins from this
  # line AND from the nine <meta> tags, and drop the integrity=
  # attributes with them. The intersection rule above means missing
  # one of the ten is not a partial failure, it is a total one.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdn.sheetjs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://xgcdbtahappoqegheitd.supabase.co; connect-src 'self' https://xgcdbtahappoqegheitd.supabase.co wss://xgcdbtahappoqegheitd.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Signed-in pages hold someone's name and account numbers. Told to
  # cache, a shared browser will happily redraw them from disk after
  # sign-out — the back button becomes a way to read the last
  # person's statement.
  <FilesMatch "\.(html)$">
    Header always set Cache-Control "no-store, must-revalidate"
  </FilesMatch>

  # The .js files carry all the behaviour, and this rule used to cover
  # .html only. That combination is worse than having neither: the
  # markup updates the instant it is uploaded because it is no-store,
  # while the scripts it depends on are served from cache with nothing
  # but a heuristic deciding for how long. A deploy therefore lands as
  # NEW MARKUP DRIVEN BY OLD CODE — new elements nothing wires up, new
  # functions the pages call and cannot find — and the symptoms look
  # like bugs in the feature that was just shipped rather than like a
  # stale file. It reproduces for whoever has visited before and not
  # for anyone testing in a fresh browser, which is the worst possible
  # signature to debug.
  #
  # no-cache rather than no-store, deliberately: no-cache still lets
  # the browser keep a copy, it just has to revalidate before using it.
  # Unchanged files come back 304 Not Modified with no body, so this
  # costs one small conditional request per file per load and never a
  # re-download. no-store would forbid keeping the copy at all and
  # re-download roughly 200KB of unchanged script on every page view.
  <FilesMatch "\.(js)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Static assets are exempt on purpose. UPSeal.png does not change
  # when the code does, and there is no version of this problem that
  # it causes.
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|woff2?)$">
    Header always set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ---- correct types ----
# A host that serves .js as text/plain will have every page silently
# do nothing, because a strict CSP refuses to execute it.
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType image/png             .png
  AddDefaultCharset UTF-8
</IfModule>

# ---- don't advertise the directory ----
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

DirectoryIndex index.html

# ---- never serve these, if one is ever uploaded by accident ----
# deploy-schema.sql holds the entire database design. The email
# templates are for pasting into Supabase, not for visitors. None of
# them belong on a web root, and this is the cheap insurance against
# the day one gets dragged in with everything else.
<FilesMatch "\.(sql|md|txt|log|bak|old|zip)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(email-|deploy-|sync-|confirm-signup)">
  Require all denied
</FilesMatch>
